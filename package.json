    "verify:capi": "tsx scripts/verify-capi.ts",
    "owner:ensure": "tsx scripts/ensure-owner.ts",
    "typecheck": "tsc --noEmit",
    "web:favicon": "python scripts/generate-favicon.py",
    "android:assets": "python scripts/generate-android-assets.py",
    "android:sync": "cap sync android",
    "android:apk": "node scripts/build-apk.mjs",
    "android:keystore": "node scripts/create-keystore.mjs",
